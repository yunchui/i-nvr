#!/bin/bash
APP_JAR="${TRIM_APPDEST}/app.jar"
JAVA_BIN="${TRIM_APPDEST}/jre/bin/java"
VAR_DIR="${TRIM_PKGVAR}"
LOG_DIR="${VAR_DIR}/logs"
PID_FILE="${VAR_DIR}/app.pid"

if [ -f "${TRIM_PKGETC}/jvm.conf" ]; then
  source "${TRIM_PKGETC}/jvm.conf"
else
  JAVA_OPTS="-Xms128m -Xmx512m -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"
fi

SPRING_ARGS="--spring.config.additional-location=file:${TRIM_PKGETC}/ --spring.profiles.active=fnos"
mkdir -p "${LOG_DIR}"

case $1 in
  start)
    if [ -f "$PID_FILE" ]; then
      old_pid=$(cat "$PID_FILE" | tr -d '[:space:]')
      if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        exit 0
      fi
      rm -f "$PID_FILE"
    fi
    if [ ! -f "$APP_JAR" ]; then
      echo "jar not found: $APP_JAR" > "${TRIM_TEMP_LOGFILE}"
      exit 1
    fi
    chmod +x "${TRIM_APPDEST}/jre/bin/"* 2>/dev/null
    # 切换工作目录到持久化数据目录，这样应用写的 .invr/ 会落在 var 下
    cd "${TRIM_PKGVAR}"
    # 清理上次残留的 Unix Socket 文件（Tomcat 不允许覆盖已存在的 socket）
    rm -f "${TRIM_APPDEST}/app.sock"
    nohup "${JAVA_BIN}" ${JAVA_OPTS} -jar "${APP_JAR}" ${SPRING_ARGS} > "${LOG_DIR}/app.log" 2>&1 &
    echo $! > "$PID_FILE"
    sleep 3
    # 修正 socket 文件权限（系统 umask 会覆盖 Tomcat 设置，nginx 需要 666 才能访问）
    chmod 666 "${TRIM_APPDEST}/app.sock" 2>/dev/null
    pid=$(cat "$PID_FILE" | tr -d '[:space:]')
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "App failed to start. Check log: ${LOG_DIR}/app.log" > "${TRIM_TEMP_LOGFILE}"
      exit 1
    fi
    exit 0
    ;;
  stop)
    if [ -f "$PID_FILE" ]; then
      pid=$(cat "$PID_FILE" | tr -d '[:space:]')
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid"
        for i in $(seq 1 15); do
          if ! kill -0 "$pid" 2>/dev/null; then break; fi
          sleep 1
        done
        if kill -0 "$pid" 2>/dev/null; then
          kill -9 "$pid"
        fi
      fi
      rm -f "$PID_FILE"
    fi
    exit 0
    ;;
  status)
    if [ -f "$PID_FILE" ]; then
      pid=$(cat "$PID_FILE" | tr -d '[:space:]')
      if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        exit 0
      fi
      rm -f "$PID_FILE"
    fi
    exit 3
    ;;
  *)
    exit 1
    ;;
esac
